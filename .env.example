# ==============================================================================
# VARIABLES DE ENTORNO - CUBIX (SISTEMA DE INTELIGENCIA ANALITICA Y CUBOS OLAP)
# ==============================================================================
# Copie este archivo como .env y complete con las credenciales de su entorno:
#   Windows: copy .env.example .env
#   Linux/Mac: cp .env.example .env
#
# NOTA: Nunca suba su archivo .env real con contrasenas a repositorios Git.

# --- BASE DE DATOS DE CONTROL Y GOBERNANZA (POSTGRESQL / SUPABASE) ---
# Cadena de conexion SQLAlchemy para PostgreSQL (Supabase o instancia administrada).
# Formato: postgresql://[usuario]:[password]@[host]:[puerto]/[base_datos]
DATABASE_URL=postgresql://postgres.tu_proyecto:tu_password@aws-0-us-west-2.pooler.supabase.com:5432/postgres

# Alternativa local: Base de datos SQLite (si no se especifica DATABASE_URL)
# DATABASE_URL=sqlite:///sistemaAnalitica/almacenamiento/controlAnalitica.db

# --- CONFIGURACION DEL SERVIDOR WEB (FASTAPI / UVICORN) ---
# Puerto de escucha (por defecto 8000 para local, en Cloud Run o Vertex se inyecta $PORT)
PORT=8000
PUERTO=8000
HOST=0.0.0.0

# Entorno de ejecucion: desarrollo | produccion
ENTORNO=produccion

# Nivel de log: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# --- SEGURIDAD Y SESIONES ---
# Clave secreta para firma de cookies de sesion analitica
SECRET_KEY=cambiar_esta_clave_secreta_en_produccion_generar_cadena_aleatoria_larga
